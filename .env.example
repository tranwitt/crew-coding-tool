# Separate model endpoints and keys. Copy this file to .env.
# Use CrewAI/LiteLLM provider prefixes as required by your endpoint.
REASONING_LLM_BASE_URL=https://api.openai.com/v1
REASONING_LLM_API_KEY=replace-with-reasoning-key
REASONING_LLM_MODEL=openai/gpt-4o

CODING_LLM_BASE_URL=https://api.openai.com/v1
CODING_LLM_API_KEY=replace-with-coding-key
CODING_LLM_MODEL=openai/gpt-4o

# Set these to the documented context window of YOUR deployed models.
# Omit to let CrewAI infer the window (unknown models may default to 8192).
# REASONING_LLM_CONTEXT_WINDOW=32768
# CODING_LLM_CONTEXT_WINDOW=32768

# Optional NVIDIA/OpenAI-compatible provider-specific JSON request body.
# Only use fields documented by your endpoint. Example (model dependent):
# REASONING_LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":true}}
# CODING_LLM_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}

# Optional sampling temperature. A low value helps models reproduce code
# exactly; leave unset for models that reject the parameter.
# REASONING_LLM_TEMPERATURE=0.2
# CODING_LLM_TEMPERATURE=0.1

# Tool calling is NOT required. By default each model is probed once and gets
# tools only if it really invokes them; pass --tool-mode text to skip the probe.

# Which OpenAI API to call: auto (default), completions, or responses.
# Some newer OpenAI models are only served by the Responses API. With auto, each
# OpenAI model gets one minimal request per run on Chat Completions; if OpenAI
# answers that the model is not served there, the run uses the Responses API.
# Set completions or responses to skip that check. Other providers always use
# Chat Completions.
# REASONING_LLM_API=auto
# CODING_LLM_API=responses

# Optional, for reasoning models (for example low, medium, high):
# CODING_LLM_REASONING_EFFORT=medium

# Optional, Responses API only: false asks OpenAI not to store the responses.
# CODING_LLM_STORE=false
